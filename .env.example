# ============================================================
#  BrandTrace — Environment Variables
#  Copy this file to .env and fill in secrets before running.
# ============================================================

# ── App Identity ────────────────────────────────────────────
PROJECT_NAME="BrandTrace"
ENVIRONMENT="development"        # development | production
TIMEZONE="Asia/Kolkata"

# ── Database (PostgreSQL required; pg_trgm extension needed) ─
# Local Docker Compose:
DATABASE_URL="postgresql+psycopg2://brandtrace:brandtrace@127.0.0.1:5432/brandtrace_db"
# Supabase (replace placeholders):
# DATABASE_URL="postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
# Render internal (auto-populated by Render):
# DATABASE_URL="postgresql://user:pass@host/dbname"

# ── LLM ─────────────────────────────────────────────────────
GROQ_API_KEY=""              # Leave blank to use cached-extraction fallback
GROQ_MODEL="llama-3.3-70b-versatile"

# ── Auth & Security ──────────────────────────────────────────
SECRET_KEY="CHANGE-ME-to-a-random-32+-char-string"
# ALLOW_ROLE_SWITCHER controls the X-User-Role dev header.
# MUST be "false" in production (enforced in guards.py).
ALLOW_ROLE_SWITCHER="true"       # true in dev, false in prod/Render
# DEMO_MODE controls 1-click visitor demo login (/auth/demo-login).
# MUST be "false" in real production; set "true" only for evaluation demos.
DEMO_MODE="false"

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set to your Vercel URL, e.g.:
#   CORS_ORIGINS="https://brandtrace.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── Server ───────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ── Frontend (.env in /frontend) ─────────────────────────────
# VITE_API_BASE_URL="http://localhost:8000"
# VITE_ALLOW_ROLE_SWITCHER="true"
